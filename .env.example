# Network
NODE_ENV=development
PORT=3000

# Upstream Mintlayer api-server (v2). Same names as the legacy wallet-batch.
TESTNET_API=https://api-server-lovelace.mintlayer.org/api/v2
MAINNET_API=https://api-server.mintlayer.org/api/v2

# CoinMarketCap price feed (GET /price, ML quote).
# NEVER commit a real key here — it is injected by the k8s Secret at deploy.
CMC_API_KEY=
CMC_COIN_ID=14977

# Upstream response cache
UPSTREAM_TTL_MS=30000

# Chain tip polling (feeds the /ws blockHeight broadcast)
CHAIN_TIP_POLL_MS=10000

# IPFS cache
IPFS_GATEWAYS=https://gateway.pinata.cloud/ipfs,https://4everland.io/ipfs,https://ipfs.io/ipfs
IPFS_TIMEOUT_MS=12000
IPFS_MAX_BYTES=5242880
IPFS_MEMORY_CACHE_MAX_ENTRIES=5000
IPFS_NEGATIVE_TTL_MS=60000
